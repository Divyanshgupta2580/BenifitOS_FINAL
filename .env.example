# BenefitOS Master Monorepo Environment Configuration Template

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://postgres:your-db-password@localhost:5432/benefitos?schema=public"

# Redis Cache & Distributed Security State
REDIS_URL="redis://localhost:6379"
SECURITY_STATE_MODE="local" # Use "distributed" for production multi-pod deployments

# JWT Authentication Secrets (Must be min 32-byte secure random string in production)
JWT_SECRET="your-secure-random-32-byte-secret-for-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-secure-random-32-byte-refresh-secret-for-production"
JWT_REFRESH_EXPIRATION="7d"

# SMTP Email Delivery Provider
SMTP_HOST="smtp.example.gov.in"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="noreply@benefitos.gov.in"
SMTP_SECURE="false"

# Supabase Storage & Database Integration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# AI Integration APIs
GEMINI_API_KEY="your-google-gemini-api-key"
GOOGLE_GEMINI_API_KEY="your-google-gemini-api-key"
SARVAM_AI_API_KEY="your-sarvam-ai-api-key"

# Backend Production API Server URL
RENDER_BACKEND_URL="http://localhost:4000"
PORT=4000

# Frontend Client Public API URL
EXPO_PUBLIC_API_URL="http://localhost:4000/api/v1"
EXPO_PUBLIC_WS_URL="ws://localhost:4000/ws"

