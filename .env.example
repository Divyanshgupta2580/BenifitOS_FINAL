# ==============================================================================
# BenefitOS — Production Environment Configuration Template
# ==============================================================================
# IMPORTANT:
# Do not commit real credentials or secrets to version control.
# Copy this file to .env and configure with production credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=production
API_PREFIX=api/v1
CORS_ORIGIN=https://benefitos.gov.in,https://app.benefitos.gov.in

# ------------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL / Neon / RDS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ------------------------------------------------------------------------------
# 3. REDIS DISTRIBUTED STATE & SESSION CACHE
# ------------------------------------------------------------------------------
REDIS_URL=rediss://default:PASSWORD@HOST:6379
SECURITY_STATE_MODE=distributed

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION TOKENS (Minimum 32-character high-entropy secret)
# ------------------------------------------------------------------------------
JWT_SECRET=YOUR_SECURE_RANDOM_ACCESS_SECRET_MIN_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=YOUR_SECURE_RANDOM_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRATION=7d

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI ASSISTANT & VISION OCR
# ------------------------------------------------------------------------------
GEMINI_API_KEY=YOUR_PRODUCTION_GEMINI_API_KEY

# ------------------------------------------------------------------------------
# 6. SMTP EMAIL DELIVERY SERVICE (RFC 5321 / TLS)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.gov.in
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
SMTP_FROM=noreply@benefitos.gov.in
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 7. DOCUMENT STORAGE PROVIDER (local / s3 / supabase)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=benefitos-documents
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------------------
# 8. FRONTEND CLIENT ENVIRONMENT VARIABLES (Vite SPA)
# ------------------------------------------------------------------------------
# VITE_API_URL=https://api.benefitos.gov.in/api/v1
# VITE_WS_URL=wss://api.benefitos.gov.in/ws
