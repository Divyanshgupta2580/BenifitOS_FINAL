# BenefitOS Backend Service Environment Template

PORT=4000
NODE_ENV=production

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:password@localhost:5432/benefitos?schema=public"

# Redis Cache Service
REDIS_URL="redis://localhost:6379"

# JWT Authentication Configuration
JWT_SECRET="super_secret_jwt_key_benefit_os_production_change_me_32_bytes"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="super_secret_jwt_refresh_key_benefit_os_32_bytes"
JWT_REFRESH_EXPIRATION="7d"

# Supabase Storage Integration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="documents"

# Google Gemini Vision OCR Key
GOOGLE_GEMINI_API_KEY="your-google-gemini-api-key"
