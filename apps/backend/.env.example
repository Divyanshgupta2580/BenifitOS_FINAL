# Server Environment
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Security Secrets
JWT_SECRET=super_secret_jwt_key_benefit_os_production_change_me_32_bytes
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_benefit_os_32_bytes
JWT_REFRESH_EXPIRATION=7d

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/benefitos?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# AI Providers Configuration
DEFAULT_AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Object Storage Configuration
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://your-supabase-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STORAGE_BUCKET_NAME=benefitos-documents

# Government Integrations Configuration
DIGILOCKER_CLIENT_ID=digilocker_client_id
DIGILOCKER_CLIENT_SECRET=digilocker_client_secret
DIGILOCKER_REDIRECT_URI=http://localhost:4000/api/v1/integrations/digilocker/callback
AADHAAR_MOCK_MODE=true

# Notification Gateways
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=smtp_user
EMAIL_SMTP_PASS=smtp_pass
EMAIL_FROM=noreply@benefitos.gov.in

SMS_GATEWAY_API_KEY=sms_gateway_key
WHATSAPP_GATEWAY_API_KEY=whatsapp_gateway_key
