# BenefitOS Backend Service Environment Template

PORT=4000
NODE_ENV=production
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# PostgreSQL Connection String
DATABASE_URL="postgresql://postgres:your-db-password@localhost:5432/benefitos?schema=public"

# Redis Cache Service & Distributed Security State
REDIS_URL="redis://localhost:6379"
SECURITY_STATE_MODE="distributed"

# JWT Authentication Configuration (Must be min 32-byte secure random string in production)
JWT_SECRET="your-secure-random-32-byte-secret-for-production"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="your-secure-random-32-byte-refresh-secret-for-production"
JWT_REFRESH_EXPIRATION="7d"

# SMTP Email Delivery Provider
SMTP_HOST="smtp.example.gov.in"
SMTP_PORT="587"
SMTP_USER="smtp-username"
SMTP_PASS="smtp-password"
SMTP_FROM="noreply@benefitos.gov.in"
SMTP_SECURE="false"

# Supabase Storage Integration
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="documents"

# Google Gemini Vision OCR Key
GEMINI_API_KEY="your-google-gemini-api-key"
GOOGLE_GEMINI_API_KEY="your-google-gemini-api-key"


