generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  OFFICER
  AUDITOR
  CITIZEN
}

enum Gender {
  MALE
  FEMALE
  TRANSGENDER
  OTHER
}

enum SocialCategory {
  GENERAL
  OBC
  SC
  ST
  EWS
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum EmploymentStatus {
  EMPLOYED
  UNEMPLOYED
  SELF_EMPLOYED
  STUDENT
  RETIRED
  FARMER
  DAILY_WAGE
}

enum DisabilityType {
  NONE
  VISUAL
  HEARING
  LOCOMOTOR
  INTELLECTUAL
  MULTIPLE
  OTHER
}

enum SchemeCategory {
  AGRICULTURE
  EDUCATION
  HEALTHCARE
  HOUSING
  FINANCIAL_INCLUSION
  WOMEN_CHILD_DEVELOPMENT
  SOCIAL_SECURITY
  SKILL_DEVELOPMENT
  EMPLOYMENT
  PENSION
}

enum DocumentType {
  BIRTH_CERTIFICATE
  EDUCATIONAL_CERTIFICATE
  DISABILITY_CERTIFICATE
  CASTE_CERTIFICATE
  AADHAAR
  DRIVING_LICENSE
  VOTER_ID
}

enum VerificationStatus {
  PENDING
  PROCESSING
  VERIFIED
  REJECTED
  MANUAL_REVIEW
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACTION_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ChannelType {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
  WEBSOCKET
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  phone             String?            @unique
  passwordHash      String
  role              Role               @default(CITIZEN)
  isEmailVerified   Boolean            @default(false)
  isPhoneVerified   Boolean            @default(false)
  mfaEnabled        Boolean            @default(false)
  mfaSecret         String?
  googleId          String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  citizenProfile    CitizenProfile?
  sessions          Session[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  notificationPref  NotificationPreference?
  aiConversations   AiConversation[]
  documents         Document[]
  applications      Application[]

  @@map("users")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  refreshToken String    @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isRevoked    Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model CitizenProfile {
  id                 String           @id @default(uuid())
  userId             String           @unique
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  gender             Gender
  maritalStatus      MaritalStatus
  socialCategory     SocialCategory   @default(GENERAL)
  employmentStatus   EmploymentStatus @default(UNEMPLOYED)
  annualIncomeINR    Float            @default(0.0)
  disabilityType     DisabilityType   @default(NONE)
  disabilityPercent  Float            @default(0.0)
  isBplCardHolder    Boolean          @default(false)
  bplCardNumber      String?
  aadhaarHash        String?          @unique
  panHash            String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  address            Address?
  householdMembers   HouseholdMember[]
  landDetails        LandDetail[]
  recommendations    SchemeRecommendation[]

  @@map("citizen_profiles")
}

model Address {
  id               String         @id @default(uuid())
  citizenProfileId String         @unique
  streetAddress    String
  city             String
  district         String
  state            String
  pincode          String
  isRural          Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  citizenProfile   CitizenProfile @relation(fields: [citizenProfileId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model HouseholdMember {
  id               String         @id @default(uuid())
  citizenProfileId String
  fullName         String
  relation         String
  age              Int
  gender           Gender
  isDependent      Boolean        @default(true)
  annualIncomeINR  Float          @default(0.0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  citizenProfile   CitizenProfile @relation(fields: [citizenProfileId], references: [id], onDelete: Cascade)

  @@map("household_members")
}

model LandDetail {
  id               String         @id @default(uuid())
  citizenProfileId String
  landSizeAcres    Float
  landType         String
  surveyNumber     String?
  district         String
  state            String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  citizenProfile   CitizenProfile @relation(fields: [citizenProfileId], references: [id], onDelete: Cascade)

  @@map("land_details")
}

model WelfareScheme {
  id                 String               @id @default(uuid())
  code               String               @unique
  title              String
  description        String
  category           SchemeCategory
  department         String
  state              String?
  isCentralScheme    Boolean              @default(true)
  financialBenefit   Float                @default(0.0)
  isActive           Boolean              @default(true)
  applicationDeadline DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  eligibilityRules   EligibilityCriteria[]
  requiredDocuments  RequiredDocument[]
  recommendations    SchemeRecommendation[]
  applications       Application[]

  @@map("welfare_schemes")
}

model EligibilityCriteria {
  id               String        @id @default(uuid())
  schemeId         String
  attributeKey     String
  operator         String
  targetValue      String
  isRequired       Boolean       @default(true)
  description      String
  createdAt        DateTime      @default(now())

  scheme           WelfareScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@map("eligibility_criteria")
}

model RequiredDocument {
  id               String        @id @default(uuid())
  schemeId         String
  documentType     DocumentType
  isMandatory      Boolean       @default(true)
  description      String
  createdAt        DateTime      @default(now())

  scheme           WelfareScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@map("required_documents")
}

model SchemeRecommendation {
  id                 String             @id @default(uuid())
  citizenProfileId   String
  schemeId           String
  matchPercentage    Float
  estimatedBenefit   Float
  isEligible         Boolean
  criteriaMet        String[]
  missingCriteria    String[]
  missingDocuments   DocumentType[]
  calculatedAt       DateTime           @default(now())

  citizenProfile     CitizenProfile     @relation(fields: [citizenProfileId], references: [id], onDelete: Cascade)
  scheme             WelfareScheme      @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([citizenProfileId, schemeId])
  @@map("scheme_recommendations")
}

model Document {
  id                 String             @id @default(uuid())
  userId             String
  documentType       DocumentType
  fileName           String
  fileSize           Int
  mimeType           String
  storagePath        String
  encryptionKeyRef   String?
  verificationStatus VerificationStatus @default(PENDING)
  uploadedAt         DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  ocrResult          OcrResult?
  verifications      DocumentVerification[]
  applicationDocs    ApplicationDocument[]

  @@index([userId])
  @@index([userId, documentType])
  @@map("documents")
}

model OcrResult {
  id               String           @id @default(uuid())
  documentId       String           @unique
  rawText          String
  confidenceScore  Float
  extractedData    Json
  processedAt      DateTime         @default(now())

  document         Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("ocr_results")
}

model DocumentVerification {
  id               String             @id @default(uuid())
  documentId       String
  officerId        String?
  status           VerificationStatus
  remarks          String?
  verifiedAt       DateTime           @default(now())

  document         Document           @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_verifications")
}

model Application {
  id               String                   @id @default(uuid())
  applicationNo    String                   @unique
  userId           String
  schemeId         String
  status           ApplicationStatus        @default(DRAFT)
  formData         Json
  remarks          String?
  submittedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheme           WelfareScheme            @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  documents        ApplicationDocument[]
  history          ApplicationStatusHistory[]

  @@index([userId])
  @@index([userId, status])
  @@map("applications")
}

model ApplicationDocument {
  id               String       @id @default(uuid())
  applicationId    String
  documentId       String

  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  document         Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([applicationId, documentId])
  @@map("application_documents")
}

model ApplicationStatusHistory {
  id               String            @id @default(uuid())
  applicationId    String
  fromStatus       ApplicationStatus
  toStatus         ApplicationStatus
  changedById      String
  note             String?
  changedAt        DateTime          @default(now())

  application      Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_histories")
}

model AiConversation {
  id               String      @id @default(uuid())
  userId           String
  title            String      @default("Welfare Assistant Chat")
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages         AiMessage[]

  @@map("ai_conversations")
}

model AiMessage {
  id               String         @id @default(uuid())
  conversationId   String
  role             String
  content          String
  tokensUsed       Int            @default(0)
  provider         String         @default("gemini")
  createdAt        DateTime       @default(now())

  conversation     AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}

model Notification {
  id               String      @id @default(uuid())
  userId           String
  title            String
  body             String
  channel          ChannelType @default(IN_APP)
  isRead           Boolean     @default(false)
  metadata         Json?
  createdAt        DateTime    @default(now())

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  emailEnabled     Boolean  @default(true)
  smsEnabled       Boolean  @default(true)
  whatsappEnabled  Boolean  @default(true)
  inAppEnabled     Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id               String   @id @default(uuid())
  userId           String?
  action           String
  resource         String
  resourceId       String?
  ipAddress        String?
  userAgent        String?
  details          Json?
  createdAt        DateTime @default(now())

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model OutboxEvent {
  id               String       @id @default(uuid())
  aggregateType    String
  aggregateId      String
  eventType        String
  payload          Json
  status           OutboxStatus @default(PENDING)
  retryCount       Int          @default(0)
  lastError        String?
  createdAt        DateTime     @default(now())
  processedAt      DateTime?

  @@index([status])
  @@map("outbox_events")
}
